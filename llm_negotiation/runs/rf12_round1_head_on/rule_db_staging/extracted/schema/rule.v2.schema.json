{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule.v2.schema.json",
  "title": "A rule of the rule database, schema version 2",
  "description": "Version 2 of the rule format (issue #30; docs/rule-format.md, section 12). Everything a rule says is as in version 1; version 2 adds three things for rules that a model generates: the source type 'stated' (one model stating a rule, beside 'negotiated' between two), an optional 'intent' (what the rule is meant to do, in words; never executed), and an optional 'screening' list (the results of replaying the rule and of screening it in a crowd). Its provenance may also carry 'generation', which only the rule writer fills, and 'promotion', which only the promotion command fills. A version 1 file is still read against the version 1 schema, unchanged. The loader then checks what a schema cannot say, as for version 1. A rule is data: nothing in it is ever run as code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_id", "version", "status", "provenance", "encounter", "when", "roles", "directive", "priority"],
  "properties": {
    "schema_version": {"const": 2},
    "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["test_seed", "candidate", "validated", "rejected", "retired"]},
    "description": {"type": "string"},
    "intent": {"type": "string", "maxLength": 500},
    "provenance": {"$ref": "#/$defs/provenance"},
    "encounter": {"enum": ["head_on", "crossing", "overtaking", "single_file_segment", "any"]},
    "when": {"$ref": "#/$defs/condition"},
    "roles": {"oneOf": [{"const": "symmetric"}, {"$ref": "#/$defs/role_assignment"}]},
    "directive": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,31}$"},
      "additionalProperties": {"$ref": "#/$defs/directive"}
    },
    "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
    "expiry": {"enum": ["passed", "out_of_range"]},
    "screening": {"type": "array", "items": {"$ref": "#/$defs/screening_entry"}}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "created_at", "author", "notes", "validation_evidence"],
      "properties": {
        "source_type": {"enum": ["hand_written", "negotiated", "stated", "extracted"]},
        "source_ref": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "author": {"type": "string", "minLength": 1},
        "notes": {"type": "string"},
        "validation_evidence": {"type": "array", "items": {"type": "object"}},
        "generation": {"$ref": "#/$defs/generation"},
        "promotion": {"$ref": "#/$defs/promotion"}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment", "condition", "case_id", "canonical_hash", "sessions"],
      "properties": {
        "experiment": {"type": "string", "minLength": 1},
        "condition": {"enum": ["negotiated", "stated"]},
        "case_id": {"type": "string", "minLength": 1},
        "canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sessions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/session_ref"}}
      }
    },
    "session_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "design_cell", "model", "prompt_template", "created_utc"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "design_cell": {"type": "object"},
        "model": {"type": "string", "minLength": 1},
        "model_returned": {"type": ["string", "null"]},
        "prompt_template": {"type": "object"},
        "created_utc": {"type": "string", "minLength": 1},
        "proposed_by": {"type": ["integer", "null"]},
        "repeat": {"type": ["integer", "null"]}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_database", "staged_rule", "staged_sha256", "reason", "promoted_utc", "by"],
      "properties": {
        "from_database": {"type": "string", "minLength": 1},
        "staged_rule": {"type": "string", "minLength": 1},
        "staged_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reason": {"type": "string", "minLength": 1},
        "promoted_utc": {"type": "string", "minLength": 1},
        "by": {"type": "string", "minLength": 1}
      }
    },
    "screening_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "experiment", "scenario", "baseline", "seeds", "screened_utc", "verdict", "reasons", "results"],
      "properties": {
        "kind": {"enum": ["replay", "crowd"]},
        "experiment": {"type": "string", "minLength": 1},
        "scenario": {"type": "string", "minLength": 1},
        "baseline": {"type": ["string", "null"]},
        "case_id": {"type": ["string", "null"]},
        "seeds": {"type": "array", "items": {"type": "integer"}},
        "screened_utc": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["passed", "failed", "recorded"]},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "results": {"type": "object"}
      }
    },
    "field_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "unit": {"enum": ["m", "s", "m/s", "rad", "deg", "years"]},
    "scalar": {"type": ["number", "string"]},
    "condition": {
      "oneOf": [
        {"$ref": "#/$defs/comparison"},
        {"$ref": "#/$defs/all"},
        {"$ref": "#/$defs/any"}
      ]
    },
    "all": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {"all": {"type": "array", "items": {"$ref": "#/$defs/condition"}}}
    },
    "any": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any"],
      "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "op", "value"],
      "properties": {
        "field": {"$ref": "#/$defs/field_name"},
        "op": {"enum": ["<", "<=", ">", ">=", "==", "!=", "in"]},
        "value": {
          "anyOf": [
            {"$ref": "#/$defs/scalar"},
            {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scalar"}}
          ]
        },
        "unit": {"$ref": "#/$defs/unit"}
      }
    },
    "role_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": {
        "by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "order", "assign", "tie"],
          "properties": {
            "field": {"$ref": "#/$defs/field_name"},
            "order": {"enum": ["ascending", "descending"]},
            "assign": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"}
            },
            "tie": {"enum": ["no_match"]},
            "tie_within": {"type": "number", "minimum": 0},
            "unit": {"$ref": "#/$defs/unit"}
          }
        }
      }
    },
    "directive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "side_preference": {"enum": ["left", "right", "none"]},
        "responsibility_share": {"type": "number", "minimum": 0, "maximum": 1},
        "speed_scale": {"type": "number", "minimum": 0},
        "clearance_margin": {"type": "number", "minimum": 0},
        "passage_order": {"enum": ["leader", "follower", "none"]}
      }
    }
  }
}
