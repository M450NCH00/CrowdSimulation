@article{rossetti2025dynamics,
  author  = {Rossetti, Charlotte S. L. and Hauser, Oliver P. and Hilbe, Christian},
  title   = {Dynamics of cooperation in concurrent games},
  journal = {Nature Communications},
  volume  = {16},
  pages   = {1524},
  year    = {2025},
  doi     = {10.1038/s41467-025-56083-7},
  note    = {Published, peer reviewed (Springer Nature), open access. [read: full text],
             refs/gt_natcomms2025_concurrent.txt. The only qualifying G6 entry. Human
             experiment with 316 UK-based students. Finding relevant to the FYP's
             generality goal, and it cuts against it: when people let behaviour cross
             between games, cooperation FALLS, and it falls because they fail to keep the
             games separate. Caveat: the games are cooperation dilemmas, not
             anti-coordination conflict games.}
}

